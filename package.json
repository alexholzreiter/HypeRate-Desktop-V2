{
  "name": "hyperate-overlay",
  "version": "1.0.6",
  "productName": "HypeRate Desktop",
  "description": "In-game heart rate overlay powered by HypeRate",
  "author": {
    "name": "HypeRate",
    "email": "hello@hyperate.io"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w @abandonware/noble",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-15",
    "discord-rpc": "^4.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.yourname.hyperate-overlay",
    "productName": "HypeRate Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!src/native/win-ble/bin/**/*",
      "!src/native/win-ble/obj/**/*",
      "!src/native/win-ble/publish/**/*",
      "!src/native/win-ble/publish-self/**/*",
      "!landing/**/*",
      "!dist/**/*",
      "!.npm-cache/**/*",
      "!node_modules/.cache/**/*"
    ],
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null,
      "sign": null,
      "extraResources": [
        {
          "from": "src/native/win-ble/publish-self",
          "to": "native/win-ble",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "assets",
          "to": "assets",
          "filter": [
            "icon.ico"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "afterPack": "./afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "HypeRate Desktop needs Bluetooth to connect to heart rate monitors directly."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons",
      "category": "Utility"
    }
  }
}
